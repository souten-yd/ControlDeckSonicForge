{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["input", "stages"],
  "properties": {
    "pipeline": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "input": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["text", "audio_grant", "audio_asset", "audio_stream"]},
        "text": {"type": ["string", "null"], "maxLength": 100000},
        "grant_id": {"type": ["string", "null"], "pattern": "^grant:[A-Za-z0-9._:-]{1,256}$"},
        "asset_id": {"type": ["string", "null"], "pattern": "^asset:[A-Za-z0-9._:-]{1,256}$"},
        "stream_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 64},
          "kind": {"enum": ["speech.asr", "host.ai.text", "speech.tts", "audio.sfx", "music.generate", "audio.process"]},
          "language": {"enum": ["auto", "ja", "en"], "default": "auto"},
          "profile": {"type": ["string", "null"], "maxLength": 120},
          "voice_id": {"type": ["string", "null"], "maxLength": 128},
          "quality": {"enum": ["fast", "balanced", "quality"], "default": "balanced"},
          "routing": {
            "type": "object",
            "properties": {
              "engine": {"type": ["string", "null"], "maxLength": 120},
              "model": {"type": ["string", "null"], "maxLength": 240},
              "device": {"type": "string", "maxLength": 64, "default": "auto"}
            },
            "additionalProperties": false
          },
          "parameters": {"type": "object", "maxProperties": 32}
        },
        "additionalProperties": false
      }
    },
    "start_at": {"type": ["string", "null"], "maxLength": 64},
    "stop_after": {"type": ["string", "null"], "maxLength": 64},
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["text", "asset", "project", "http", "websocket", "package"], "default": "asset"},
        "profile": {"type": "string", "minLength": 1, "maxLength": 120, "default": "default"},
        "project_output_grant": {"type": ["string", "null"], "pattern": "^grant:[A-Za-z0-9._:-]{1,256}$"},
        "filename": {"type": ["string", "null"], "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
