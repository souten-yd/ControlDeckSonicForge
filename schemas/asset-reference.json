{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asset_id": {"type": "string", "pattern": "^asset:[A-Za-z0-9._:-]{1,256}$"},
    "job_id": {"type": "string", "pattern": "^job:[A-Za-z0-9._:-]{1,256}$"}
  },
  "oneOf": [
    {"required": ["asset_id"]},
    {"required": ["job_id"]}
  ],
  "additionalProperties": false
}
